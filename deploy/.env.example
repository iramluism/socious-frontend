# Copy to deploy/.env before: make deploy / make deploy-prod
# Vite inlines VITE_* at image build. Changing API URLs requires --build.

FRONTEND_HTTP_PORT=8081

# Local Docker smoke can keep relative paths. Production must use absolute HTTPS.
VITE_MEMO_API_BASE=https://socious-api.iramluism.com/api/v1/memo
VITE_AUTH_API_BASE=https://socious-api.iramluism.com/api/v1/auth
VITE_OAUTH_AUTHORIZE_ACTION=https://socious-api.iramluism.com/oauth/authorize

# Production only (make deploy-prod). Token from Cloudflare Zero Trust; never commit the real value.
CLOUDFLARE_TUNNEL_TOKEN=
