# Base path for Memo REST routes (proxied to Socius in dev).
VITE_MEMO_API_BASE=/api/v1/memo
# Base path for Auth REST routes (sign-up, login, me).
VITE_AUTH_API_BASE=/api/v1/auth
# Native form POST target for OAuth authorize (same-origin via Vite /oauth proxy).
VITE_OAUTH_AUTHORIZE_ACTION=/oauth/authorize
